  "item": [
    {
      "name": "AddBook",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.collectionVariables.set(\"flag\", false)\r",
              "\r",
              "const code = pm.globals.get(\"companyCode\");\r",
              "console.log(code);\r",
              "const value = pm.variables.replaceIn('{{$randomInt}}');\r",
              "console.log(value);\r",
              "pm.collectionVariables.set(\"isbn\", code + value);\r",
              "const aisleId = pm.variables.replaceIn('{{$randomInt}}');\r",
              "pm.collectionVariables.set(\"aisle\", aisleId);\r",
              "\r",
              "pm.collectionVariables.set(\"book_name\", pm.iterationData.get(\"BookName\"));\r",
              "console.log(pm.collectionVariables.get(\"book_name\"));\r",
              "pm.collectionVariables.set(\"author_name\", pm.iterationData.get(\"Author\"));\r",
              "console.log(pm.collectionVariables.get(\"author_name\"));\r",
              "\r",
              "\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.collectionVariables.set(\"flag\", false);\r",
              "const jsonData = pm.response.json();\r",
              "const id = jsonData.ID;\r",
              "console.log(id);\r",
              "pm.environment.set(\"book_id\", id);\r",
              "var req = JSON.parse(pm.request.body.raw);\r",
              "\r",
              "\r",
              "function generateBookId()\r",
              "{\r",
              "    const expectedID = req.isbn + req.aisle;\r",
              "    return expectedID;\r",
              "}\r",
              "\r",
              "function cleanupScript()\r",
              "{\r",
              "    const bookid = generateBookId();\r",
              "    pm.environment.set(\"book_id\", bookid)\r",
              "    pm.collectionVariables.set(\"flag\", true);\r",
              "    pm.execution.setNextRequest(\"DeleteBook\");\r",
              "}\r",
              "\r",
              "pm.test(\"Validate Status code is 200\", function ()\r",
              "{\r",
              "    try\r",
              "    {\r",
              "        pm.response.to.have.status(200);\r",
              "        pm.expect(jsonData).have.property(\"Msg\");\r",
              "        pm.expect(jsonData.Msg).to.eql(\"successfully added\");\r",
              "    }\r",
              "    catch(err)\r",
              "    {\r",
              "        if((jsonData.Msg).includes(\"Exists\"))\r",
              "        {\r",
              "            cleanupScript();\r",
              "        }\r",
              "    }\r",
              "   \r",
              "});\r",
              "\r",
              "pm.test(\"Validate header response\", function ()\r",
              "{\r",
              "    pm.response.to.have.header(\"Content-Type\");\r",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.eql(\"application/json;charset=UTF-8\");\r",
              "    pm.expect(pm.response.responseTime).to.below(2000);\r",
              "    pm.expect(pm.response.text()).to.include(\"successfully added\")\r",
              "});\r",
              "\r",
              "pm.test(\"Book ID logic validation\", function() \r",
              "{\r",
              "    const expectedbookid = generateBookId();\r",
              "    pm.expect(expectedbookid).to.eql(id);\r",
              "});\r",
              "\r",
              "\r",
              "\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n\"name\":\"{{book_name}}\",\r\n\"isbn\":\"{{isbn}}\",\r\n\"aisle\":\"{{aisle}}\",\r\n\"author\":\"{{author_name}}\"\r\n}\r\n\r\n\r\n\r\n\r\n",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/Library/Addbook.php",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "Library",
            "Addbook.php"
          ]
        }
      },
      "response": []
    },
    {
      "name": "GetBook",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const bookingResponse = pm.response.json();\r",
              "const schema = {\r",
              "    \"title\": \"Generated schema for Root\",\r",
              "  \"type\": \"array\",\r",
              "  \"items\": [\r",
              "    {\r",
              "    \"type\": \"object\",\r",
              "    \"properties\": {\r",
              "      \"book_name\": {\r",
              "        \"type\": \"string\"\r",
              "      },\r",
              "      \"isbn\": {\r",
              "        \"type\": \"string\"\r",
              "      },\r",
              "      \"aisle\": {\r",
              "        \"type\": \"string\"\r",
              "      },\r",
              "      \"author\": {\r",
              "        \"type\": \"string\"\r",
              "      }\r",
              "    },\r",
              "    \"required\": [\r",
              "      \"book_name\",\r",
              "      \"isbn\",\r",
              "      \"aisle\",\r",
              "      \"author\"\r",
              "    ]\r",
              "  }\r",
              "  ]\r",
              "};\r",
              "\r",
              "pm.test(\"Validate response data\", function ()\r",
              "{\r",
              "    const isbnnumber = bookingResponse[0].isbn;\r",
              "    const authorname = bookingResponse[0].author;\r",
              "    pm.expect(isbnnumber).to.eql(pm.collectionVariables.get(\"isbn\"));\r",
              "    pm.expect(authorname).to.eql(pm.collectionVariables.get(\"author_name\"));\r",
              "});\r",
              "\r",
              "pm.test(\"Validate response schema\", function() \r",
              "{\r",
              "    pm.response.to.have.status(200);\r",
              "    pm.response.to.have.jsonSchema(schema);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/Library/GetBook.php?ID={{book_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "Library",
            "GetBook.php"
          ],
          "query": [
            {
              "key": "ID",
              "value": "{{book_id}}"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "DeleteBook",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const deleteBookingResponse = pm.response.json();\r",
              "const schema = {\r",
              "  \"type\": \"object\",\r",
              "  \"properties\": {\r",
              "    \"msg\": {\r",
              "      \"type\": \"string\"\r",
              "    }\r",
              "  },\r",
              "  \"required\": [\r",
              "    \"msg\"\r",
              "  ]\r",
              "};\r",
              "\r",
              "pm.test(\"Validate response data and schema\", function() \r",
              "{\r",
              "    pm.response.to.have.status(200);\r",
              "    pm.response.to.have.jsonSchema(schema);\r",
              "    pm.expect(deleteBookingResponse.msg).to.eql(\"book is successfully deleted\");\r",
              "    if(pm.environment.get(\"flag\"))\r",
              "    {\r",
              "        pm.execution.setNextRequest(\"AddBook\");\r",
              "    }\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n \r\n\"ID\": \"{{book_id}}\"\r\n \r\n} \r\n",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/Library/DeleteBook.php",
          "host": [
            "{{base_url}}"

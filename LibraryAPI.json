    {
      "name": "GetBook_Invalid",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const jsonData = pm.response.json();\r",
              "\r",
              "pm.test(\"Validate status code is 400\", function () \r",
              "{\r",
              "    pm.response.to.have.status(404);\r",
              "});\r",
              "\r",
              "pm.test(\"Error message is correct for invalid Book ID\", function ()\r",
              "{\r",
              "    pm.expect(jsonData.msg).to.eql(\"The book by requested bookid / author name does not exists!\");\r",
              "});\r",
              "\r",
              "pm.test(\"validate Response has msg field\", function ()\r",
              "{\r",
              "    pm.expect(jsonData).to.have.property(\"msg\");\r",
              "});\r",
              "\r",
              "pm.test(\"Response time is less than 200ms\", function ()\r",
              "{\r",
              "    pm.expect(pm.response.responseTime).to.be.below(500);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
